# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (public client + server service role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API (server-only; never NEXT_PUBLIC_*)
# Use Google AI Studio / Gemini API, not OpenAI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Upstash Redis (rate limits)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry (DSN is ingest-oriented; still do not commit real values)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional: enable source map upload in CI/CD only
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
